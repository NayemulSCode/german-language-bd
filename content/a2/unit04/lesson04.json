  "grammar": [
    {
      "type": "order",
      "title": "dass-বাক্য: ক্রিয়া শেষে",
      "text": "dass = „যে“ (সংযোজক)। মূল বাক্যের পরে কমা, তারপর dass + বাকি অংশ, ক্রিয়া শেষে। কমা বাধ্যতামূলক।",
      "de": [
