  "grammar": [
    {
      "type": "table",
      "title": "kein — „… নেই / কোনো … না“",
      "intro": "kein আসলে ein-এর নেতিবাচক রূপ। ein যে রূপে বসত, kein সেই রূপেই বসে (ব্যতিক্রম: বহুবচনেও keine হয়)।",
      "head": [
        "",
        "কর্তা (Nominativ)",
        "haben-এর পরে (Akkusativ)"
      ],
      "rows": [
        [
          "der Hund",
          "kein Hund",
          "keinen Hund"
        ],
        [
          "die Katze",
          "keine Katze",
          "keine Katze"
        ],
        [
          "das Auto",
          "kein Auto",
          "kein Auto"
        ],
        [
          "die Kinder (বহু.)",
          "keine Kinder",
          "keine Kinder"
        ]
      ],
      "note": "Ich habe keinen Hund = আমার কুকুর নেই। — বাংলায় „নেই“ ক্রিয়ার সাথে মেশে, জার্মানে kein বিশেষ্যের সামনে বসে।"
    },
    {
      "type": "text",
      "title": "kein নাকি nicht?",
      "text": "kein — বিশেষ্যকে (যার আগে ein থাকত বা কোনো আর্টিকেলই থাকত না) নাকচ করে: „Ich habe kein Auto.“, „Ich habe keine Zeit.“, „Ich habe kein Geld.“ nicht — ক্রিয়া, বিশেষণ বা পুরো বাক্যকে নাকচ করে: „Ich arbeite nicht.“, „Das ist nicht gut.“ সহজ নিয়ম: যে বিশেষ্যের আগে ein বসতে পারে → kein।"
    }
  ],
