  "grammar": [
    {
      "type": "text",
      "title": "অক্ষরের নাম (আনুমানিক বাংলা উচ্চারণ)",
      "text": "A (আ) · B (বে) · C (ৎসে) · D (দে) · E (এ) · F (এফ) · G (গে) · H (হা) · I (ঈ) · J (ইয়ট) · K (কা) · L (এল) · M (এম) · N (এন) · O (ও) · P (পে) · Q (কু) · R (এর) · S (এস) · T (তে) · U (উ) · V (ফাউ) · W (ভে) · X (ইকস) · Y (ঊপসিলন) · Z (ৎসেট)। সবগুলো শব্দ ট্যাপ করে শুনে নিন — ঠিক উচ্চারণ শোনাটাই আসল।"
    },
    {
      "type": "text",
      "title": "বিশেষ অক্ষর: ä, ö, ü, ß",
      "text": "ä — „এ“-এর কাছাকাছি (Bär)। ö — ঠোঁট গোল করে „এ“ বলা (schön)। ü — ঠোঁট গোল করে „ই“ বলা (Tschüss)। ß — তীক্ষ্ণ „স“ (heißen), „ডবল s“ হিসেবে ভাবুন। কিবোর্ডে না পেলে ae, oe, ue, ss লেখা যায়।"
    },
    {
      "type": "text",
      "title": "বাংলাভাষীর জন্য সাবধান",
      "text": "w = „ভ“ (Wasser, wohnen), v = „ফ“ (Vater, viel), z = „ৎস“ (Zahl, zehn), j = „ইয়“ (Jahr, ja), sch = „শ“ (Schule), ch = নরম „খ/হ“ শব্দ (ich), ei = „আই“, ie = লম্বা „ঈ“, eu = „অয়“। জার্মানে বেশিরভাগ শব্দ যেমন লেখা তেমনই পড়া হয়।"
    }
  ],
