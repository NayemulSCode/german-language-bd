# Copy to .env.local for local development, and add the same two values to your host's
# environment variables (Cloudflare Pages / GitHub Actions) for production.
# Both are PUBLIC values: the anon key is safe in the browser because row-level security protects the data.
# Leave them empty to run the app without login (progress stays on the device).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Server-side only. The app in this repo does not use the next two; never prefix them with VITE_ (that would ship them to every browser).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_DB_PASSWORD=YOUR-DATABASE-PASSWORD

# Optional "support the app" card (both are PUBLIC: they are shown to every visitor). Leave empty to hide the card.
# VITE_SUPPORT_URL must start with https:// (e.g. your Buy Me a Coffee or Ko-fi page).
VITE_SUPPORT_URL=
VITE_BKASH_NUMBER=
# Printable packs page: where buyers message you after paying: one or more https links separated by spaces
# (e.g. https://t.me/yourname https://wa.me/8801XXXXXXXXX), and a short price line.
VITE_PACKS_CONTACT_URL=
VITE_PACKS_PRICE=
