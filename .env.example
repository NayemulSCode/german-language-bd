# Copy to .env.local for local development, and add the same two values to your host's
# environment variables (Cloudflare Pages / GitHub Actions) for production.
# Both are PUBLIC values: the anon key is safe in the browser because row-level security protects the data.
# Leave them empty to run the app without login (progress stays on the device).
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
# Server-side only. The app in this repo does not use the next two; never prefix them with VITE_ (that would ship them to every browser).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
SUPABASE_DB_PASSWORD=YOUR-DATABASE-PASSWORD
